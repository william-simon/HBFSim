+TEST_CASE("filter_out_version_headers_ptx keeps the highest PTX version",
+	  "[ptxpass_core]")
+{
+	// The trampoline (.version 8.1) precedes a pass output that needs 8.7.
+	std::string input = R"(.version 8.1
+.target sm_61
+.address_size 64
+.visible .func tramp() { ret; }
+.version 8.7
+.target sm_89
+.address_size 64
+.visible .entry foo() { ret; }
+)";
+	std::string filtered = filter_out_version_headers_ptx(input);
+	REQUIRE(filtered.rfind(".version 8.7\n", 0) == 0);
+	REQUIRE(filtered.find(".version", 1) == std::string::npos);
+	REQUIRE(filter_out_version_headers_ptx(".version 8.10\n.version 8.7\n")
+			.rfind(".version 8.10\n", 0) == 0);
+	REQUIRE_THROWS(filter_out_version_headers_ptx(".version eight\n"));
+}
+
