+static std::pair<int, int> parse_ptx_version_line(std::string_view line)
+{
+	std::string text(line.substr(8));
+	const auto dot = text.find('.');
+	try {
+		if (dot == std::string::npos)
+			throw std::invalid_argument("missing minor version");
+		std::size_t major_end = 0, minor_end = 0;
+		const int major = std::stoi(text, &major_end);
+		if (major_end != dot)
+			throw std::invalid_argument("malformed major version");
+		const int minor = std::stoi(text.substr(dot + 1), &minor_end);
+		return { major, minor };
+	} catch (const std::exception &) {
+		throw std::runtime_error("invalid PTX .version line: " +
+					 std::string(line));
+	}
+}
+
+// Merged modules (for example the trampoline followed by a pass output) keep
+// one header of each kind. The single .version line declares the highest
+// version among the parts: keeping the first one can declare a lower version
+// than an instruction later in the module needs.
 std::string filter_out_version_headers_ptx(const std::string &input)
 {
 	static const std::string FILTERED_OUT_PREFIXES[] = {
 		".version", ".target", ".address_size", "//"
 	};
 
+	std::optional<std::pair<int, int>> highest;
+	for_each_line(input, [&](std::string_view line) {
+		if (line.rfind(".version", 0) == 0) {
+			const auto version = parse_ptx_version_line(line);
+			if (!highest || version > *highest)
+				highest = version;
+		}
+	});
+
 	std::set<std::string> seen;
 	std::string filtered;
 	filtered.reserve(input.size());
@@ -183,8 +216,16 @@ std::string filter_out_version_headers_ptx(const std::string &input)
 				break;
 			}
 		}
-		if (!skip)
-			filtered.append(line).push_back('\n');
+		if (skip)
+			return;
+		if (line.rfind(".version", 0) == 0) {
+			filtered.append(".version " +
+					std::to_string(highest->first) + "." +
+					std::to_string(highest->second));
+		} else {
+			filtered.append(line);
+		}
+		filtered.push_back('\n');
 	});
 	return filtered;
 }
